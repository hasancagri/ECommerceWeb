# Dev: VITE_API_BASE_URL boş bırakılırsa api çağrıları relative /api → vite proxy (vite.config) gateway'e.
# Prod (same-origin ingress): boş bırak → tarayıcı app.<host>/api'ye relative vurur, ingress gateway'e yönlendirir.
VITE_API_BASE_URL=

# OIDC (Identity.Server). Dev'de boşsa authConfig localhost:5001/5173 fallback'ini kullanır.
# Prod build-arg (Dockerfile) ile canlı host'lar geçilir.
VITE_OIDC_AUTHORITY=
VITE_OIDC_REDIRECT=
VITE_OIDC_POST_LOGOUT=
